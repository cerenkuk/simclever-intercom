# Web Debrief Server Configuration
DEBRIEF_DATABASE_URL=sqlite:///debrief.local.db
DEBRIEF_MEDIA_ROOT=./debrief-media
HOST=0.0.0.0
PORT=8000

# AI / LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini  # Options: gemini, local_qwen
LOCAL_LLM_URL=http://localhost:8080/completion

# ASR & Audio Pipeline Configuration
WHISPER_MODEL=base
AUDIO_SAMPLE_RATE=16000
VAD_AGGRESSIVENESS=2
